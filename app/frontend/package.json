{
  "name": "resumebot-frontend",
  "private": true,
  "version": "2.5.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:package": "tsc -b && vite build --outDir ../backend/app/page --emptyOutDir",
    "build:package-temp": "tsc -b && vite build --outDir node_modules/.page-build --emptyOutDir",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@xyflow/react": "^12.12.1",
    "d3-force": "^3.0.1",
    "dagre": "^0.8.5",
    "process-view": "file:../packages/process-view",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/dagre": "^0.7.54",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
