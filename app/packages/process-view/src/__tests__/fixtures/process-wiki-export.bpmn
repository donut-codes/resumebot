<?xml version='1.0' encoding='utf-8'?>
<!-- A file as process-wiki writes it: tagged documentation (instructions, criteria, commands, prompts), its own
     extension elements (who owns a step, what it uses), a diagram, and the odd characters real files carry. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:pa="http://processatlas.local/bpmn/extensions" id="Definitions_1a2b3c4d" targetNamespace="http://processatlas.local/bpmn">
  <bpmn:process id="Process_5e6f7a8b" name="Approve an invoice" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_clerk" name="AP Clerk">
        <bpmn:flowNodeRef>Step_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Step_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Step_gate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_manager" name="Finance Manager">
        <bpmn:flowNodeRef>Step_second</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Step_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Step_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Step_start" name="Invoice received">
      <bpmn:documentation id="Step_start_instructions">Open the shared mailbox and pick up the invoice.</bpmn:documentation>
      <bpmn:messageEventDefinition messageRef="Message_invoice"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Step_review" name="Review the invoice &amp; the purchase order" camunda:candidateGroups="ap-clerk">
      <bpmn:documentation id="Step_review_instructions">Check the amount against the purchase order &amp; the supplier's terms (net 30).</bpmn:documentation>
      <bpmn:documentation id="Step_review_commands">erp.find_po --invoice {id} --supplier "{name}"</bpmn:documentation>
      <bpmn:documentation id="Step_review_prompts">Ask the agent: does this invoice match PO {po}? Answer yes, no or unsure.</bpmn:documentation>
      <bpmn:extensionElements>
        <pa:owner name="Finance"/>
        <pa:role name="AP Clerk"/>
        <pa:person name="Dana Reyes"/>
        <pa:software name="SAP"/>
        <pa:software name="Outlook"/>
        <pa:document name="Purchase order"/>
        <pa:control reference="A.9.4" framework="ISO 27001"/>
        <pa:control reference="CC6.1"/>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Step_gate" name="Over the limit?" default="Flow_small">
      <bpmn:documentation id="Step_gate_criteria">Over $5,000 needs a second approver; anything less is paid on the clerk's say-so.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Step_second" name="Second approval">
      <bpmn:documentation>Ask the Finance Manager to approve; there is no tag on this one, so it is read as the instructions.</bpmn:documentation>
      <bpmn:extensionElements>
        <pa:role name="Finance Manager"/>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Step_pay" name="Pay the supplier">
      <bpmn:documentation id="Step_pay_commands"><![CDATA[erp.pay --invoice {id} --when "<due date>"]]></bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Step_end" name="Paid"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Step_start" targetRef="Step_review"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_review" targetRef="Step_gate"/>
    <bpmn:sequenceFlow id="Flow_big" name="Over $5,000" sourceRef="Step_gate" targetRef="Step_second">
      <bpmn:conditionExpression>amount &gt; 5000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_small" name="Otherwise" sourceRef="Step_gate" targetRef="Step_pay"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_second" targetRef="Step_pay"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Step_pay" targetRef="Step_end"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_5e6f7a8b">
      <bpmndi:BPMNShape id="Shape_Step_start" bpmnElement="Step_start">
        <dc:Bounds x="0" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_review" bpmnElement="Step_review">
        <dc:Bounds x="150" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_gate" bpmnElement="Step_gate">
        <dc:Bounds x="300" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_second" bpmnElement="Step_second">
        <dc:Bounds x="450" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_pay" bpmnElement="Step_pay">
        <dc:Bounds x="600" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_end" bpmnElement="Step_end">
        <dc:Bounds x="750" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
